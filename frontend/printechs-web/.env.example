# Public site URL used for canonical / OG URLs and analytics page_location.
# Production launch example:
# NEXT_PUBLIC_SITE_URL=https://printechs.com
NEXT_PUBLIC_SITE_URL=https://demo.printechs.com/newwebsite

# Remove /newwebsite at production root launch:
# NEXT_PUBLIC_BASE_PATH=
NEXT_PUBLIC_BASE_PATH=/newwebsite

# Enable search indexing at production launch.
NEXT_PUBLIC_ALLOW_INDEXING=false

# Future ERPNext API base (demo only). Never put secrets in NEXT_PUBLIC_* vars.
NEXT_PUBLIC_ERPNEXT_URL=https://demo.printechs.com
ERPNEXT_URL=https://printechs.com

# Server-side API credentials (optional).
# ERPNEXT_API_KEY=
# ERPNEXT_API_SECRET=

# --- Analytics (configure before launch) ---
NEXT_PUBLIC_GTM_ID=
NEXT_PUBLIC_GA_MEASUREMENT_ID=
NEXT_PUBLIC_CLARITY_PROJECT_ID=
NEXT_PUBLIC_GOOGLE_SITE_VERIFICATION=
NEXT_PUBLIC_ANALYTICS_DEBUG=false
